{
  "name": "@databuddy/auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/auth-client.ts",
    "./logger": "./src/logger.ts",
    "./permissions": "./src/permissions.ts",
    "./oauth": "./src/oauth.ts",
    "./mcp-grant": "./src/mcp-grant.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "mailing-list:sync": "bun src/scripts/sync-mailing-list.ts",
    "two-factor:recover": "bun src/scripts/two-factor-recovery.ts",
    "test": "bun test src",
    "test:integration": "BUSINESS_CONTEXT_INTEGRATION_TESTS=true MCP_OAUTH_INTEGRATION_TESTS=true ORGANIZATION_INTEGRATION_TESTS=true PASSWORD_RESET_INTEGRATION_TESTS=true TWO_FACTOR_INTEGRATION_TESTS=true REQUIRE_EMAIL_VERIFICATION=false bun test --isolate src/organization-metadata.integration.test.ts src/organization-membership-cache.integration.test.ts src/mcp-oauth.integration.test.ts src/password-reset.integration.test.ts src/two-factor.integration.test.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/redis-storage": "1.7.7",
    "@databuddy/db": "*",
    "@databuddy/email": "*",
    "@databuddy/env": "workspace:*",
    "@databuddy/notifications": "workspace:*",
    "@databuddy/redis": "*",
    "@databuddy/services": "workspace:*",
    "@databuddy/shared": "workspace:*",
    "autumn-js": "catalog:",
    "better-auth": "1.7.7",
    "drizzle-kit": "^1.0.0-rc.1",
    "evlog": "catalog:",
    "resend": "^6.12.3"
  }
}
